{
  "name": "skills",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "oxlint --type-aware --fix --ignore-path .gitignore",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.sh": "shellcheck --severity=warning"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
